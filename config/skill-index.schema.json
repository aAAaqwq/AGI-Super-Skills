{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aaaaqwq.github.io/AGI-Super-Team/schemas/skill-index.schema.json",
  "title": "AGI Super Team generated skill index",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "inventorySemantics", "inventoryCount", "categories", "skills"],
  "properties": {
    "$schema": {"const": "../config/skill-index.schema.json"},
    "schemaVersion": {"const": 2},
    "inventorySemantics": {"type": "string", "minLength": 20},
    "inventoryCount": {"type": "integer", "minimum": 0},
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "emoji", "title", "description", "count"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "emoji": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 3},
          "description": {"type": "string", "minLength": 12},
          "count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {"$ref": "#/$defs/skill"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "skillIdentifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "match_count", "matched_signals", "priority", "tied_for_first"],
      "properties": {
        "category_id": {"$ref": "#/$defs/identifier"},
        "match_count": {"type": "integer", "minimum": 0},
        "matched_signals": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "priority": {"type": "integer", "minimum": 0},
        "tied_for_first": {"type": "boolean"}
      }
    },
    "winner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "match_count", "matched_signals", "priority", "tie_detected"],
      "properties": {
        "category_id": {"$ref": "#/$defs/identifier"},
        "match_count": {"type": "integer", "minimum": 0},
        "matched_signals": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "priority": {"type": "integer", "minimum": 0},
        "tie_detected": {"type": "boolean"}
      }
    },
    "classificationDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "winner", "matched_signals", "runner_ups", "resolution_status", "review_state"],
      "properties": {
        "method": {"enum": ["outcome", "slug", "description", "override", "fallback"]},
        "winner": {"$ref": "#/$defs/winner"},
        "matched_signals": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "runner_ups": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
        "base_method": {"enum": ["outcome", "slug", "description", "fallback"]},
        "base_candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
        "rationale": {"type": "string", "minLength": 20},
        "resolution_status": {"enum": ["rule-match", "priority-tie", "override", "fallback"]},
        "review_state": {"const": "unreviewed"}
      },
      "allOf": [
        {
          "if": {"properties": {"method": {"const": "override"}}, "required": ["method"]},
          "then": {
            "required": ["base_method", "base_candidates", "rationale"],
            "properties": {
              "resolution_status": {"const": "override"},
              "matched_signals": {"maxItems": 0},
              "runner_ups": {"maxItems": 0},
              "winner": {
                "properties": {
                  "match_count": {"const": 0},
                  "matched_signals": {"maxItems": 0},
                  "tie_detected": {"const": false}
                }
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["base_method"]},
                {"required": ["base_candidates"]},
                {"required": ["rationale"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"method": {"const": "fallback"}}, "required": ["method"]},
          "then": {
            "properties": {
              "resolution_status": {"const": "fallback"},
              "matched_signals": {"maxItems": 0},
              "runner_ups": {"maxItems": 0},
              "winner": {
                "properties": {
                  "match_count": {"const": 0},
                  "matched_signals": {"maxItems": 0},
                  "tie_detected": {"const": false}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"method": {"enum": ["outcome", "slug", "description"]}}, "required": ["method"]},
          "then": {
            "properties": {
              "resolution_status": {"enum": ["rule-match", "priority-tie"]},
              "winner": {"properties": {"match_count": {"minimum": 1}}}
            }
          }
        },
        {
          "if": {"properties": {"resolution_status": {"const": "rule-match"}}, "required": ["resolution_status"]},
          "then": {
            "properties": {
              "winner": {"properties": {"tie_detected": {"const": false}}},
              "runner_ups": {
                "not": {"contains": {"properties": {"tied_for_first": {"const": true}}, "required": ["tied_for_first"]}}
              }
            }
          }
        },
        {
          "if": {"properties": {"resolution_status": {"const": "priority-tie"}}, "required": ["resolution_status"]},
          "then": {
            "properties": {
              "winner": {"properties": {"tie_detected": {"const": true}}},
              "runner_ups": {
                "contains": {"properties": {"tied_for_first": {"const": true}}, "required": ["tied_for_first"]}
              }
            }
          }
        }
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "level"],
      "properties": {
        "agent": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"},
        "level": {"enum": ["required", "optional", "harnessSpecific"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_kind", "review_state"],
      "properties": {
        "origin_kind": {"enum": ["project-original", "adapted", "collected", "unknown"]},
        "review_state": {"enum": ["reviewed", "unreviewed", "stale"]},
        "authors": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "creation_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "license": {"type": "object"},
        "upstream": {"type": "object"},
        "adaptations": {"type": "array", "items": {"type": "string"}},
        "declared_hints": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"properties": {"origin_kind": {"const": "unknown"}}, "required": ["origin_kind"]},
          "then": {"properties": {"review_state": {"enum": ["unreviewed", "stale"]}}}
        },
        {
          "if": {"properties": {"review_state": {"const": "reviewed"}}, "required": ["review_state"]},
          "then": {"not": {"properties": {"origin_kind": {"const": "unknown"}}, "required": ["origin_kind"]}}
        }
      ]
    },
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "runtime_evidence"],
      "properties": {
        "status": {"enum": ["unscored", "stale", "selected", "candidate", "hold"]},
        "runtime_evidence": {"enum": ["pending", "prompt-tested", "fixture-one-harness", "fixture-two-harness", "external-beta"]},
        "reviewed_at": {"type": "string", "format": "date"},
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "tier": {"enum": ["exemplary", "recommended", "selected", "candidate", "hold"]},
        "dimensions": {"type": "object"},
        "reason": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["unscored", "stale"]}}, "required": ["status"]},
          "then": {
            "not": {"anyOf": [{"required": ["score"]}, {"required": ["tier"]}, {"required": ["dimensions"]}]}
          },
          "else": {
            "required": ["reviewed_at", "score", "tier", "dimensions", "reason", "evidence", "limitations"]
          }
        }
      ]
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "category_id", "description", "support_level", "used_by", "assignments", "portability_class", "review_signals", "description_status", "classification", "classification_details", "provenance", "curation", "path"],
      "properties": {
        "skill_id": {"$ref": "#/$defs/skillIdentifier"},
        "category_id": {"$ref": "#/$defs/identifier"},
        "description": {"type": "string", "minLength": 1},
        "support_level": {"enum": ["pack-required", "catalog"]},
        "used_by": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "assignments": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/assignment"}},
        "portability_class": {"enum": ["portable-required", "portable-optional", "harness-specific", "catalog-only"]},
        "review_signals": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "description_status": {"enum": ["source-text", "needs-review"]},
        "classification": {"type": "string", "minLength": 1},
        "classification_details": {"$ref": "#/$defs/classificationDetails"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "curation": {"$ref": "#/$defs/curation"},
        "path": {"type": "string", "pattern": "^skills/[a-z0-9]+(?:[-_][a-z0-9]+)*/SKILL\\.md$"}
      },
      "oneOf": [
        {
          "properties": {
            "assignments": {
              "minItems": 1,
              "contains": {"properties": {"level": {"const": "required"}}, "required": ["level"]}
            },
            "portability_class": {"const": "portable-required"},
            "support_level": {"const": "pack-required"}
          }
        },
        {
          "properties": {
            "assignments": {
              "minItems": 1,
              "contains": {"properties": {"level": {"const": "optional"}}, "required": ["level"]},
              "not": {"contains": {"properties": {"level": {"const": "required"}}, "required": ["level"]}}
            },
            "portability_class": {"const": "portable-optional"},
            "support_level": {"const": "catalog"}
          }
        },
        {
          "properties": {
            "assignments": {
              "minItems": 1,
              "contains": {"properties": {"level": {"const": "harnessSpecific"}}, "required": ["level"]},
              "allOf": [
                {"not": {"contains": {"properties": {"level": {"const": "required"}}, "required": ["level"]}}},
                {"not": {"contains": {"properties": {"level": {"const": "optional"}}, "required": ["level"]}}}
              ]
            },
            "portability_class": {"const": "harness-specific"},
            "support_level": {"const": "catalog"}
          }
        },
        {
          "properties": {
            "assignments": {"maxItems": 0},
            "portability_class": {"const": "catalog-only"},
            "support_level": {"const": "catalog"}
          }
        }
      ]
    }
  }
}
