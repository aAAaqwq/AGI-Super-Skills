{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aAAaqwq/AGI-Super-Team/config/harness-adapters/codex.schema.json",
  "title": "AGI Super Team Codex C-suite adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "harness",
    "coordinator",
    "independentReviewer",
    "maxParallelLeaves",
    "fallbackModes",
    "runtimeEvidence",
    "agentMap",
    "requiredMaxDepth",
    "managerAgentMap"
  ],
  "properties": {
    "$schema": {"const": "./codex.schema.json"},
    "schemaVersion": {"const": 1},
    "harness": {"const": "codex"},
    "coordinator": {"const": "ceo"},
    "independentReviewer": {"const": "governor"},
    "maxParallelLeaves": {"type": "integer", "minimum": 1, "maximum": 4},
    "fallbackModes": {
      "const": ["native", "manual", "sequential"]
    },
    "runtimeEvidence": {
      "enum": ["pending", "fixture-tested", "external-receipt"]
    },
    "agentMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "additionalProperties": {"type": "string", "pattern": "^ast-[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "requiredMaxDepth": {"const": 2},
    "managerAgentMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cto", "cpo", "cco", "cfo", "cdo", "cqo", "cmo", "cro", "cso", "coo", "clo"],
      "properties": {
        "cto": {"$ref": "#/$defs/manager"},
        "cpo": {"$ref": "#/$defs/manager"},
        "cco": {"$ref": "#/$defs/manager"},
        "cfo": {"$ref": "#/$defs/manager"},
        "cdo": {"$ref": "#/$defs/manager"},
        "cqo": {"$ref": "#/$defs/manager"},
        "cmo": {"$ref": "#/$defs/manager"},
        "cro": {"$ref": "#/$defs/manager"},
        "cso": {"$ref": "#/$defs/manager"},
        "coo": {"$ref": "#/$defs/manager"},
        "clo": {"$ref": "#/$defs/manager"}
      }
    }
  },
  "$defs": {
    "manager": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "requiredMaxDepth", "maxConcurrentChildren", "fallbackMode", "delegates", "roleRefs"],
      "properties": {
        "agent": {"type": "string", "pattern": "^ast-(cto|cpo|cco|cfo|cdo|cqo|cmo|cro|cso|coo|clo)$"},
        "requiredMaxDepth": {"const": 2},
        "maxConcurrentChildren": {"const": 2},
        "fallbackMode": {"const": "parent-flat"},
        "delegates": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "additionalProperties": {"type": "string", "pattern": "^ast-(cto|cpo|cco|cfo|cdo|cqo|cmo|cro|cso|coo|clo)-[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "roleRefs": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "additionalProperties": {"type": "string", "pattern": "^ast-[a-z0-9]+(?:-[a-z0-9]+)*$"}
        }
      }
    }
  }
}
