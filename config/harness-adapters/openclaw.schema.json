{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aAAaqwq/AGI-Super-Team/config/harness-adapters/openclaw.schema.json",
  "title": "AGI Super Team OpenClaw adapter contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "harness",
    "targetVersion",
    "namespace",
    "coordinator",
    "independentReviewer",
    "paths",
    "connection",
    "requiredMaxDepth",
    "maxChildrenPerAgent",
    "runtimeEvidence"
  ],
  "properties": {
    "$schema": {"const": "./openclaw.schema.json"},
    "schemaVersion": {"const": 2},
    "harness": {"const": "openclaw"},
    "targetVersion": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]+\\.[0-9]+(?:-[0-9]+)?$"},
    "namespace": {"const": "agi-super-team"},
    "coordinator": {"const": "ast-ceo"},
    "independentReviewer": {"const": "ast-governor"},
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installationRoot", "configPath", "workspaceRoot", "managedSkillRoot", "connection"],
      "properties": {
        "installationRoot": {"const": "configDir"},
        "configPath": {
          "type": "object",
          "additionalProperties": false,
          "required": ["precedence"],
          "properties": {
            "precedence": {
              "const": [
                "connection.mergeContract.configPath",
                "OPENCLAW_CONFIG_PATH",
                "targetStateDir/openclaw.json"
              ]
            }
          }
        },
        "workspaceRoot": {"const": "agency-agents/agi-super-team"},
        "managedSkillRoot": {"const": "skills/agi-super-team"},
        "connection": {"const": "agi-super-team/connection.json"}
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listPath",
        "key",
        "strategy",
        "managedPrefix",
        "conflictPolicy",
        "removeUnmentionedManaged",
        "generateBindings"
      ],
      "properties": {
        "listPath": {"const": "agents.list"},
        "key": {"const": "id"},
        "strategy": {"const": "upsert-managed-preserve-unmanaged"},
        "managedPrefix": {"const": "ast-"},
        "conflictPolicy": {"const": "fail-unless-previewed"},
        "removeUnmentionedManaged": {"const": false},
        "generateBindings": {"const": false}
      }
    },
    "requiredMaxDepth": {"const": 2},
    "maxChildrenPerAgent": {"const": 2},
    "runtimeEvidence": {"const": "pending"}
  }
}
