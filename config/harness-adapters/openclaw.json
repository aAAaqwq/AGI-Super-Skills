{
  "$schema": "./openclaw.schema.json",
  "schemaVersion": 2,
  "harness": "openclaw",
  "targetVersion": "2026.6.8",
  "namespace": "agi-super-team",
  "coordinator": "ast-ceo",
  "independentReviewer": "ast-governor",
  "paths": {
    "installationRoot": "configDir",
    "configPath": {
      "precedence": [
        "connection.mergeContract.configPath",
        "OPENCLAW_CONFIG_PATH",
        "targetStateDir/openclaw.json"
      ]
    },
    "workspaceRoot": "agency-agents/agi-super-team",
    "managedSkillRoot": "skills/agi-super-team",
    "connection": "agi-super-team/connection.json"
  },
  "connection": {
    "listPath": "agents.list",
    "key": "id",
    "strategy": "upsert-managed-preserve-unmanaged",
    "managedPrefix": "ast-",
    "conflictPolicy": "fail-unless-previewed",
    "removeUnmentionedManaged": false,
    "generateBindings": false
  },
  "requiredMaxDepth": 2,
  "maxChildrenPerAgent": 2,
  "runtimeEvidence": "pending"
}
