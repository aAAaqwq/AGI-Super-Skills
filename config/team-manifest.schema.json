{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aAAaqwq/AGI-Super-Team/config/team-manifest.schema.json",
  "title": "AGI Super Team manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "inventory",
    "agents",
    "kits"
  ],
  "properties": {
    "$schema": {
      "const": "./team-manifest.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentCount",
        "physicalSkillCount",
        "skillEntrypoint",
        "symlinkPolicy"
      ],
      "properties": {
        "agentCount": {
          "type": "integer",
          "minimum": 1
        },
        "physicalSkillCount": {
          "type": "integer",
          "minimum": 0
        },
        "skillEntrypoint": {
          "const": "SKILL.md"
        },
        "symlinkPolicy": {
          "const": "forbid"
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/agent"
      }
    },
    "kits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/kit"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "skillList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "path",
        "focus",
        "outputs",
        "boundary",
        "skills"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^agents/[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "focus": {
          "type": "string",
          "minLength": 24
        },
        "outputs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "boundary": {
          "type": "string",
          "minLength": 24
        },
        "skills": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "optional",
            "harnessSpecific",
            "recommendedExternal"
          ],
          "properties": {
            "required": {
              "$ref": "#/$defs/skillList"
            },
            "optional": {
              "$ref": "#/$defs/skillList"
            },
            "harnessSpecific": {
              "$ref": "#/$defs/skillList"
            },
            "recommendedExternal": {
              "$ref": "#/$defs/skillList"
            }
          }
        }
      }
    },
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "outcome",
        "entrypoint",
        "coordinator",
        "reviewers",
        "coreAgents",
        "agents",
        "outputs",
        "checks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "outcome": {
          "type": "string",
          "minLength": 24
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^starter-kits/[a-z0-9]+(?:-[a-z0-9]+)*/RUNBOOK\\.md$"
        },
        "coordinator": {
          "$ref": "#/$defs/identifier"
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "coreAgents": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "agents": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "checks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  }
}
