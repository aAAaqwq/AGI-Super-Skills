{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill quality debt baseline",
  "type": "object",
  "required": ["schemaVersion", "structureInvalid", "disclosureWarnings", "executionReviewRequired", "issueCounts"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "scope": {"type": "string"},
    "structureInvalid": {"type": "integer", "minimum": 0},
    "disclosureWarnings": {"type": "integer", "minimum": 0},
    "executionReviewRequired": {"type": "integer", "minimum": 0},
    "issueCounts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  },
  "additionalProperties": false
}
