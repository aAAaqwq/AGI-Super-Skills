{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aAAaqwq/AGI-Super-Team/config/agent-hierarchy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "coordinator", "requiredMaxDepth", "recommendedMaxThreads", "executionPolicy", "managers"],
  "properties": {
    "$schema": {"const": "./agent-hierarchy.schema.json"},
    "schemaVersion": {"const": 1},
    "coordinator": {"const": "ceo"},
    "requiredMaxDepth": {"const": 2},
    "recommendedMaxThreads": {"type": "integer", "minimum": 4},
    "executionPolicy": {"const": "wave"},
    "managers": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/manager"},
      "required": ["cto", "cpo", "cco"]
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "manager": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxConcurrentChildren", "routingFile", "roleRefs", "subagents"],
      "properties": {
        "maxConcurrentChildren": {"const": 2},
        "routingFile": {"type": "string", "pattern": "^config/[a-z0-9-]+\\.json$"},
        "roleRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "subagents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
