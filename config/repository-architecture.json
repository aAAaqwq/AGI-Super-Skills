    {"path": "scripts", "role": "implementation", "module": "verification-evidence", "authority": false},
    {"path": "scripts/build_agent_skill_indexes.py", "role": "implementation", "module": "team-composition", "authority": false},
    {"path": "scripts/build_codex_csuite_adapter.py", "role": "implementation", "module": "distribution-adapters", "authority": false},
    {"path": "scripts/build_skill_catalog.py", "role": "implementation", "module": "catalog-discovery", "authority": false},
