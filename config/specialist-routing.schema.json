{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aAAaqwq/AGI-Super-Team/config/specialist-routing.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "parent", "requiredMaxDepth", "maxConcurrentLeaves", "source", "roleRoutes", "specialists"],
  "properties": {
    "$schema": {"const": "./specialist-routing.schema.json"},
    "schemaVersion": {"const": 1},
    "parent": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "requiredMaxDepth": {"const": 2},
    "maxConcurrentLeaves": {"const": 2},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "license", "notice"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license": {"const": "MIT"},
        "notice": {"type": "string", "minLength": 20}
      }
    },
    "roleRoutes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/routeRef"}},
    "specialists": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/specialist"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "nonEmptyList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "route": {
      "type": "object",
      "required": ["id", "name", "trigger", "doNotUseWhen", "requiredInputs", "outputs", "acceptance", "partners", "boundary"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 2},
        "trigger": {"type": "string", "minLength": 20},
        "doNotUseWhen": {"type": "string", "minLength": 16},
        "requiredInputs": {"$ref": "#/$defs/nonEmptyList"},
        "outputs": {"$ref": "#/$defs/nonEmptyList"},
        "acceptance": {"$ref": "#/$defs/nonEmptyList"},
        "partners": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "boundary": {"type": "string", "minLength": 20}
      }
    },
    "routeRef": {
      "allOf": [{"$ref": "#/$defs/route"}],
      "unevaluatedProperties": false
    },
    "specialist": {
      "allOf": [
        {"$ref": "#/$defs/route"},
        {
          "type": "object",
          "required": ["sourcePath"],
          "properties": {
            "sourcePath": {"type": "string", "pattern": "^(marketing|specialized|design|engineering)/[a-z0-9-]+\\.md$"},
            "sourceRole": {"type": "string", "minLength": 2},
            "adaptation": {"type": "string", "minLength": 20}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
