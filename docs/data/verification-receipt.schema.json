{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aaaaqwq.github.io/AGI-Super-Team/schemas/verification-receipt.schema.json",
  "title": "AGI Super Team verification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "commit", "siteCommit", "pack", "harness", "fixture", "checks", "result", "limitations"],
  "properties": {
    "$schema": {"const": "./verification-receipt.schema.json"},
    "schemaVersion": {"const": 1},
    "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "siteCommit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "pack": {"type": "string", "minLength": 1},
    "harness": {"type": "string", "minLength": 1},
    "fixture": {"type": ["string", "null"], "minLength": 1},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "result": {"enum": ["passed", "failed"]},
          "details": {"type": "string"}
        }
      }
    },
    "result": {"enum": ["pending", "passed", "failed"]},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "passed"}}, "required": ["result"]},
      "then": {
        "properties": {
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "siteCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "fixture": {"type": "string", "minLength": 1},
          "checks": {"minItems": 1}
        }
      }
    }
  ]
}
