# ============================================================
# 5minbtc 配置模板
# ============================================================
# 用法:
#   cp .env.example .env
#   按需修改后 source .env
#
# ⚠️ 重要说明:
#   当前引擎 (5minbtc-engine-v5.7.py) 不读取任何环境变量,
#   所有参数硬编码在源码中以保证 cron 调用的零配置可复现性。
#   本文件列出的是【建议配置化】的项,作为二次开发的参考起点。
#   若要让引擎实际读取这些变量,需修改对应源码 (欢迎 PR)。
# ============================================================


# ---------- 通用 / 路径 ----------

# 技能根目录 (用于 cron / 脚本拼接路径, 避免硬编码绝对路径)
# 例: /home/aa/.hermes/profiles/cqo/skills/5minbtc
SKILL_DIR=

# 时区偏移 (小时), 引擎默认 CST=UTC+8
# 当前硬编码: 5minbtc-engine-v5.7.py: CST = timezone(timedelta(hours=8))
TIMEZONE_OFFSET_HOURS=8


# ---------- 交易标的 ----------

# 交易对 (当前硬编码 fetch_klines/fetch_depth 形参默认值)
SYMBOL=BTCUSDT

# K 线周期 (当前硬编码 fetch_klines 形参默认值)
INTERVAL=5m

# 拉取的 K 线根数 (当前硬编码 fetch_klines limit=200)
KLINES_LIMIT=200

# 订单簿深度档位 (当前硬编码 fetch_depth limit=20)
DEPTH_LIMIT=20


# ---------- 数据源 URL (当前硬编码, 均为公开免认证接口) ----------

# Binance 公开数据 API (无需 API Key)
BINANCE_KLINES_URL=https://data-api.binance.vision/api/v3/klines
BINANCE_DEPTH_URL=https://data-api.binance.vision/api/v3/depth

# Coinbase BTC-USD 现货价 (Chainlink 偏移补偿参考)
COINBASE_SPOT_URL=https://api.coinbase.com/v2/prices/BTC-USD/spot

# 恐惧贪婪指数 (黑天鹅过滤, FNG<25 触发)
FNG_URL=https://api.alternative.me/fng/


# ---------- 网络与超时 ----------

# 各 HTTP 请求超时 (秒)
# 当前硬编码: klines=10, depth=5 (见 urlopen 调用)
# 注: 高延迟网络 (>250ms) 下 Binance 端点会 SSL 超时,
#     临时调高到 25 可缓解, 跑完务必恢复。
#     详见 references/high-latency-network-handling.md
HTTP_TIMEOUT_KLINES=10
HTTP_TIMEOUT_DEPTH=5

# 并行 HTTP 工作线程数 (v5.7.3 并行化: klines+depth+FNG+chainlink)
# 当前硬编码: ThreadPoolExecutor(max_workers=4)
HTTP_WORKERS=4

# 是否禁用 SSL 证书验证 (对抗高延迟网络 SSL 握手超时)
# 当前硬编码: ssl._create_default_https_context = ssl._create_unverified_context
# 在可信网络下建议设为 false 并恢复验证
DISABLE_SSL_VERIFY=true


# ---------- 预测参数 (当前硬编码, 影响预测区间) ----------

# ATR 乘数 (预测范围收窄, 只预测剩余 ~55% 时间)
# 当前硬编码: predict_close_v5() 内 ×0.55
ATR_MULTIPLIER=0.55

# half_body 因子激活阈值 (K 线进度百分比)
# 当前硬编码: progress>=45% 时激活
HALF_BODY_ACTIVATE_PCT=45

# Chainlink 偏移补偿上限 (美元), 超过则视为异常并丢弃
# 当前硬编码: abs(cl_offset)>300 → 置零
CHAINLINK_OFFSET_CAP=300


# ---------- 黑天鹅防护阈值 ----------

# FNG 极度恐慌阈值, 低于此值触发 fng_black_swan
# 当前硬编码: fng_value < 25
FNG_BLACK_SWAN_THRESHOLD=25


# ---------- 调度 (cron) ----------

# 每根 5min K 线内的执行分钟 (v5.7: 第 4 分钟, progress~60-80%)
# 供 crontab 编写参考, 引擎自身不读取
CRON_EXEC_MINUTE=4


# ---------- 安全提示 ----------

# 本项目所有数据源均为公开免认证接口, 无需任何 API Key / Secret。
# 请勿将私钥、交易所 API 密钥提交到本仓库 (已由 .gitignore 排除 *.env / *.key / *.secret)。
