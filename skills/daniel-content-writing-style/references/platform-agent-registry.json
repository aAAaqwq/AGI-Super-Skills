        "resolution_status",
        "resolution_checked_at",
        "invocation_count",
        "task_ref",
        "completion_status"
      ],
      "diff_contract": {
        "must_be_empty": [
          "claim_diff",
          "evidence_diff",
          "boundary_diff"
        ],
        "may_be_nonempty": [
          "presentation_changes"
        ],
        "on_missing_or_invalid": "BLOCK",
        "on_forbidden_diff": "BLOCK"
      },
      "baseline_gap_policy": "角色只返回策略、brief 或框架而没有 platform_content_candidate 时，视为 OUTPUT_CONTRACT_VIOLATION 并 BLOCK；不得由主 Agent 补写冒充专家成稿。"
    },
