{
  "name": "agi-super-team",
  "version": "1.0.0",
  "description": "Evidence-backed AI team packs with preview-first installation and repository contracts",
  "type": "module",
  "scripts": {
    "test": "npm run test:repository && npm run test:installer && npm run check:agent-indexes && npm run check:codex-team && npm run check:skills && npm run check:skill-quality && npm run check:taxonomy-evaluation && npm run check:architecture",
    "test:repository": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:installer": "bash tests/installer/test_install.sh",
    "validate": "python3 scripts/validate_repository.py",
    "validate:strict": "python3 scripts/validate_repository.py --warnings-as-errors",
    "build:agent-indexes": "python3 scripts/build_agent_skill_indexes.py",
    "check:agent-indexes": "python3 scripts/build_agent_skill_indexes.py --check",
    "build:codex-team": "python3 scripts/build_codex_csuite_adapter.py",
    "check:codex-team": "python3 scripts/build_codex_csuite_adapter.py --check",
    "build:skills": "python3 scripts/build_skill_catalog.py",
    "check:skills": "python3 scripts/build_skill_catalog.py --check",
    "build:skill-quality": "python3 scripts/audit_skill_quality.py",
    "check:skill-quality": "python3 scripts/audit_skill_quality.py --check",
    "build:taxonomy-evaluation": "python3 scripts/build_skill_taxonomy_evaluation.py",
    "check:taxonomy-evaluation": "python3 scripts/build_skill_taxonomy_evaluation.py --check",
    "check:architecture": "python3 scripts/audit_architecture.py --check"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "ai-agent",
    "skills",
    "c-suite",
    "multi-agent"
  ]
}
