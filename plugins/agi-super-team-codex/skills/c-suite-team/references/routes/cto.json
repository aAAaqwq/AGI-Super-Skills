  "roleRoutes": [
    {
      "id": "pe",
      "name": "PE（Linus Torvalds）",
      "trigger": "架构与范围已经批准，需要一个负责人跨模块实现、集成、测试、代码评审和可回退交付。",
      "doNotUseWhen": "只需要一个窄领域的设计、审计或专项实现建议；此时直接调用对应工程专家。",
      "requiredInputs": [
        "已批准设计",
        "范围与非目标",
        "代码所有权",
        "验收命令",
        "回滚边界"
      ],
      "outputs": [
        "可运行实现",
        "回归测试",
        "可审查变更集",
        "验证回执"
      ],
      "acceptance": [
        "实现符合批准边界",
        "相关测试真实运行",
        "失败和风险可见",
        "不吞并无关改动"
      ],
      "partners": [
        "frontend-developer",
        "backend-architect",
        "security-engineer"
      ],
      "boundary": "PE 是 CTO 直属交付叶子，不得继续创建子 Agent；提交、推送、部署和不可逆操作仍需明确批准。"
    }
  ],
  "specialists": [
